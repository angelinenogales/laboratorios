#include <iostream>
using namespace std;

// Función que solicita N valores y calcula el promedio
float calcularPromedio(int N)
{
    float num, suma = 0;

    for(int i = 1; i <= N; i++)
    {
        cout << "Ingrese valor " << i << ": ";
        cin >> num;

        suma = suma + num;
    }

    return suma / N;
}

int main()
{
    int N;

    cout << "¿Cuantos valores desea ingresar?: ";
    cin >> N;

    float promedio = calcularPromedio(N);

    cout << "El promedio es: " << promedio;

    return 0;
}
