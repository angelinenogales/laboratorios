#include <iostream>
using namespace std;

// Función que cuenta los dígitos pares
int contarPares(int numero)
{
    int digito;
    int contador = 0;

    while(numero > 0)
    {
        digito = numero % 10;

        if(digito % 2 == 0)
        {
            contador++;
        }

        numero = numero / 10;
    }

    return contador;
}

int main()
{
    int numero;

    cout << "Ingrese un numero entero positivo: ";
    cin >> numero;

    cout << "Cantidad de digitos pares: " << contarPares(numero);

    return 0;
}
