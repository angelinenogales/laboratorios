#include <iostream>
using namespace std;

// Función que calcula la suma de 1 hasta N
int sumaHastaN(int N)
{
    int suma = 0;

    for(int i = 1; i <= N; i++)
    {
        suma = suma + i;
    }

    return suma;
}

int main()
{
    int N;

    cout << "Ingrese un numero entero positivo: ";
    cin >> N;

    cout << "La suma de 1 hasta " << N << " es: " << sumaHastaN(N);

    return 0;
}
