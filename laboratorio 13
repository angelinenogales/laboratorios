#include <iostream>
using namespace std;

int main()
{
    string dias[7] = {
        "Lunes",
        "Martes",
        "Miercoles",
        "Jueves",
        "Viernes",
        "Sabado",
        "Domingo"
    };
    
    float ventas[7];
    float total = 0;
    
    for(int i = 0; i < 7; i++)
    {
        cout << "Venta del " << dias[i] << ": ";
        cin >> ventas[i];
        
        total += ventas[i];
    }
    
    float promedio = total / 7;
    
    float mayor = ventas[0];
    float menor = ventas[0];
    
    int posMayor = 0;
    int posMenor = 0;
    
    for(int i = 1; i < 7; i++)
    {
        if(ventas[i] > mayor)
        {
            mayor = ventas[i];
            posMayor = i;
        }
        
        if(ventas[i] < menor)
        {
            menor = ventas[i];
            posMenor = i;
        }
    }
    
    int superiores = 0;
    
    for(int i = 0; i < 7; i++)
    {
        if(ventas[i] > promedio)
        {
            superiores++;
        }
    }
    
    cout << "\n===== REPORTE SEMANAL =====\n";
    cout << "Total vendido: " << total << endl;
    cout << "Promedio de ventas: " << promedio << endl;
    cout << "Mayor venta: " << dias[posMayor] << " (" << mayor << ")" << endl;
    cout << "Menor venta: " << dias[posMenor] << " (" << menor << ")" << endl;
    cout << "Dias con ventas superiores al promedio: " << superiores << endl;
    
    return 0;
}
