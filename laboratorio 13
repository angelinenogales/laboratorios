#include <iostream>
using namespace std;

int main()
{
    float temp[15];
    float suma = 0;
    
    for(int i = 0; i < 15; i++)
    {
        cout << "Temperatura del dia " << i + 1 << ": ";
        cin >> temp[i];
        
        suma += temp[i];
    }
    
    float mayor = temp[0];
    float menor = temp[0];
    
    for(int i = 1; i < 15; i++)
    {
        if(temp[i] > mayor)
            mayor = temp[i];
            
        if(temp[i] < menor)
            menor = temp[i];
    }
    
    float promedio = suma / 15;
    
    int mayorPromedio = 0;
    int menorDiez = 0;
    
    for(int i = 0; i < 15; i++)
    {
        if(temp[i] > promedio)
            mayorPromedio++;
            
        if(temp[i] < 10)
            menorDiez++;
    }
    
    cout << "\nTEMPERATURAS REGISTRADAS\n";
    
    for(int i = 0; i < 15; i++)
    {
        cout << temp[i] << " ";
    }
    
    cout << "\n\nTemperatura maxima: " << mayor;
    cout << "\nTemperatura minima: " << menor;
    cout << "\nPromedio general: " << promedio;
    cout << "\nDias con temperatura mayor al promedio: " << mayorPromedio;
    cout << "\nDias con temperatura menor a 10 grados: " << menorDiez;
    
    return 0;
}
