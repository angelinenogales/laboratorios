#include <iostream>
using namespace std;

int main()
{
    int N;
    
    cout << "Cantidad de estudiantes: ";
    cin >> N;
    
    float notas[N];
    float suma = 0;
    
    for(int i = 0; i < N; i++)
    {
        do
        {
            cout << "Ingrese la nota del estudiante " << i + 1 << ": ";
            cin >> notas[i];
        }
        while(notas[i] < 0 || notas[i] > 100);
        
        suma += notas[i];
    }
    
    float mayor = notas[0];
    float menor = notas[0];
    
    for(int i = 0; i < N; i++)
    {
        if(notas[i] > mayor)
            mayor = notas[i];
            
        if(notas[i] < menor)
            menor = notas[i];
    }
    
    cout << "\nNOTAS REGISTRADAS\n";
    
    for(int i = 0; i < N; i++)
    {
        cout << notas[i] << " ";
    }
    
    cout << "\nPromedio: " << suma / N;
    cout << "\nNota mayor: " << mayor;
    cout << "\nNota menor: " << menor;
    
    return 0;
}
