#include <iostream>
#include <vector>
#include <string>
using namespace std;

// Función para registrar preguntas
void registrarPreguntas(vector<string> &preguntas, int cantidad)
{
    string pregunta;

    cin.ignore();

    for(int i = 0; i < cantidad; i++)
    {
        do
        {
            cout << "\nPregunta " << i + 1 << ": ";
            getline(cin, pregunta);

            if(pregunta.length() == 0)
            {
                cout << "La pregunta no puede estar vacia." << endl;
                continue;
            }

            if(pregunta.at(0) == ' ' ||
               pregunta.at(pregunta.length()-1) == ' ')
            {
                cout << "No se permiten espacios al inicio o al final." << endl;
                pregunta = "";
            }

        } while(pregunta.length() == 0);

        preguntas.push_back(pregunta);
    }
}

// Función para mostrar preguntas
void mostrarPreguntas(vector<string> preguntas)
{
    cout << "\n===== PREGUNTAS REGISTRADAS =====\n" << endl;

    for(int i = 0; i < preguntas.size(); i++)
    {
        cout << i + 1 << ". " << preguntas[i] << endl;
    }
}

int main()
{
    int cantidad;

    cout << "Ingrese la cantidad de preguntas: ";
    cin >> cantidad;

    vector<string> preguntas;

    registrarPreguntas(preguntas, cantidad);

    mostrarPreguntas(preguntas);

    return 0;
}
