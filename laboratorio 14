#include <iostream>
#include <string>
using namespace std;

int BuscarSubCadena(string a, string b)
{
    int posicion = b.find(a);

    if(posicion != string::npos)
        return posicion;

    return -1;
}

int main()
{
    string subcadena, cadena;

    cout << "Ingrese la subcadena: ";
    getline(cin, subcadena);

    cout << "Ingrese la cadena: ";
    getline(cin, cadena);

    int resultado = BuscarSubCadena(subcadena, cadena);

    cout << "Posicion: " << resultado;

    return 0;
}
